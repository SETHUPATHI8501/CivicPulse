{
  "expo": {
    "name": "CivicPulse AI",
    "slug": "civicpulse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.civicpulse.ai"
    },
    "android": {
      "package": "gov.civicpulse.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CivicPulse AI to use your location for geotagging civic complaints."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CivicPulse AI to access photos for attaching evidence to civic complaints."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e66e053f-e564-470d-8247-9c0d98ae9b86"
      }
    }
  }
}
