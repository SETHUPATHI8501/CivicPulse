# ==========================================
# CivicPulse AI — .gitignore
# Team: Alronclad | KSRIET
# ARSW001 – Our Town, Reimagined
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python & FastAPI ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Database (SQLite & Local) ---
*.db
*.sqlite
*.sqlite3
backend/backups/
!backend/backups/.gitkeep

# --- Backend Uploads ---
backend/uploads/complaints/*
!backend/uploads/complaints/.gitkeep
backend/uploads/resolutions/*
!backend/uploads/resolutions/.gitkeep

# --- Node.js & React/Vite Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
frontend/dist/
frontend/.vite/
dist/
dist-ssr/
*.local

# --- OS & Editor Cache ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

